<resources xmlns:tools="http://schemas.android.com/tools">
  <!--
    Android 12 (API 31) replaced the launch window background with the platform
    SplashScreen API: `android:windowBackground` is ignored, and the system draws
    `windowSplashScreenAnimatedIcon` on `windowSplashScreenBackground` instead.
    Without these the launch screen is a flat colour with no branding on every
    modern device. The pre-31 layer-list in `values/styles.xml` still covers
    older ones.
  -->
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowSplashScreenBackground">@color/splashscreen_background</item>
    <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@mipmap/ic_launcher</item>
  </style>
</resources>
